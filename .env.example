# FlyWiki 单命令自托管基础设施
#
# 复制为 .env 并按需修改。所有密钥必须自行生成，不得使用此模板的默认值。
# 生产部署时所有密码和密钥必须为强随机值，且不得入库。

# --- FlyWiki 核心 ---
FLYWIKI_ENVIRONMENT=production

# --- DeepAgents 研究运行时 ---
# 支持 OpenAI 官方接口和兼容 OpenAI API 的模型服务。
MODEL_NAME=gpt-5-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 兼容旧配置；设置后优先于 MODEL_NAME，也可使用 provider:model 格式。
# FLYWIKI_AGENT_MODEL=openai:gpt-5-mini

# --- 数据库 ---
POSTGRES_USER=flywiki
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=flywiki
POSTGRES_PORT=5432

# Langfuse 使用同一 Postgres 实例的独立数据库
LANGFUSE_DB=langfuse

# --- 缓存与队列 ---
REDIS_PORT=6379

# --- 对象存储 (MinIO) ---
MINIO_ROOT_USER=flywiki
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_RANDOM
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
FLYWIKI_BUCKET=flywiki-sources
LANGFUSE_BUCKET=langfuse

# --- 观测与评估 (Langfuse，M0 必选) ---
# 首次启动前生成强随机值：
#   LANGFUSE_SALT=$(openssl rand -hex 32)
#   LANGFUSE_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)
LANGFUSE_SALT=CHANGE_ME_RUN_openssl_rand_hex_32
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_RUN_openssl_rand_base64_32
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_RUN_openssl_rand_base64_32
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_PORT=3000

# Langfuse ClickHouse
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_RANDOM

# FlyWiki 观测后端：noop（关闭观测）或 langfuse（开启观测）
FLYWIKI_OBSERVABILITY_BACKEND=noop
# 开启观测时通过 Langfuse 界面生成项目 API 密钥对并填入：
FLYWIKI_LANGFUSE_PUBLIC_KEY=
FLYWIKI_LANGFUSE_SECRET_KEY=

# --- FlyWiki 服务端口 ---
API_PORT=8000
WEB_PORT=8080

# --- OpenKB 编译 Worker（固定 OpenKB v0.4.5 / ac118407）---
OPENKB_IMAGE=flywiki/openkb-worker:0.4.5-flywiki.1
OPENKB_MODEL=gpt-5-mini
OPENKB_LANGUAGE=zh
OPENKB_PORT=8100
FLYWIKI_OPENKB_WORKER_URL=http://openkb-worker:8100
# 回退 Worker 仅在主 Worker 网络不可用或返回 502/503/504 时启用。
FLYWIKI_OPENKB_FALLBACK_WORKER_URL=
FLYWIKI_OPENKB_TIMEOUT_SECONDS=1800
